# Data Mode: 'mock' (local UI-first sample data) or 'supabase' (live production database)
DATA_MODE=mock
NEXT_PUBLIC_DATA_MODE=mock

# Supabase – copy from your Supabase project Settings → API (used when DATA_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key – server-side only, NEVER exposed to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
